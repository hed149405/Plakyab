# Backend Configuration
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Secret Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://plakyab:plakyab_password@postgres:5432/plakyab
DATABASE_ECHO=true
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# JWT Configuration
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ALGORITHM=HS256

# API Configuration
API_VERSION=v1
API_TITLE=Vehicle Information & Diagnostics Platform
API_DESCRIPTION=Enterprise-grade vehicle information management system
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@plakyab.com

# Authorized Vehicle Provider API Configuration
# NOTE: Only use authorized, official vehicle information APIs
VEHICLE_API_PROVIDER=official-provider
VEHICLE_API_KEY=your-api-key-from-official-provider
VEHICLE_API_URL=https://api.official-provider.com/v1
VEHICLE_API_TIMEOUT=30
VEHICLE_API_RETRIES=3

# VIN Decoder Configuration
VIN_VALIDATION_ENABLED=true
VIN_ISO_3779_COMPLIANT=true
VIN_CACHE_TTL=86400

# Mobile App Configuration
MOBILE_APP_NAME=Plakyab
MOBILE_APP_VERSION=1.0.0
MOBILE_API_TIMEOUT=30

# Feature Flags
FEATURE_OFFLINE_MODE=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_ANALYTICS=true
FEATURE_DARK_MODE=true
FEATURE_MULTI_LANGUAGE=true

# Admin Configuration
ADMIN_EMAIL=admin@plakyab.local
ADMIN_DEFAULT_PASSWORD=admin123456
ADMIN_DASHBOARD_URL=/admin

# Security Configuration
SECURE_COOKIE=false
HTTP_ONLY_COOKIE=true
SAME_SITE_COOKIE=lax

# Database Seeding
DATABASE_SEED_INITIAL_DATA=true

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Sentry Configuration (for error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics Configuration
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
