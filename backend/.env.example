# Backend
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Secret Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://plakyab:plakyab_password@postgres:5432/plakyab
DATABASE_ECHO=true
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=50

# JWT Configuration
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ALGORITHM=HS256

# API Configuration
API_VERSION=v1
API_TITLE=Vehicle Information & Diagnostics Platform
API_DESCRIPTION=Enterprise-grade vehicle information management system

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Vehicle Provider API Configuration
VEHICLE_API_PROVIDER=official-provider
VEHICLE_API_KEY=
VEHICLE_API_URL=
VEHICLE_API_TIMEOUT=30
VEHICLE_API_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
